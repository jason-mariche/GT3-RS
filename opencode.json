{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--profile",
        "rennsport_asus"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=mbgfvjihksbrzhniumic&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "powershell.exe",
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "C:\\Users\\Business\\.local\\share\\github-mcp-server\\start-github-mcp.ps1"
      ],
      "enabled": true
    },
    "foundry-mcp": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "C:\\Users\\Business\\.claude\\scripts\\foundry-mcp.cmd"
      ],
      "enabled": true
    },
    "powerbi-modeling-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@microsoft/powerbi-modeling-mcp@latest",
        "--start"
      ],
      "enabled": true
    }
  }
}
